#!/bin/bash
set -e

# The Giver Architecture — Deploy to GitHub Gists
# Same gist IDs are always updated (no new gists created)

SKILL_GIST_ID="9d2c84f8926e63705800498c4e3d2ab9"
README_GIST_ID="d2af61b767624526205167e1194c4155"

PROJECT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
SKILL_FILE="$PROJECT_DIR/.pi/agent/skills/giver/SKILL.md"
README_FILE="$PROJECT_DIR/README.md"

# Colors
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

echo -e "${YELLOW}=== The Giver Deploy ===${NC}"
echo ""

# Check files exist
for f in "$SKILL_FILE" "$README_FILE"; do
    if [ ! -f "$f" ]; then
        echo "Error: $f not found"
        exit 1
    fi
done

# Update SKILL.md gist
echo -e "${GREEN}[1/2]${NC} Updating SKILL.md gist ($SKILL_GIST_ID)..."
SKILL_CONTENT=$(cat "$SKILL_FILE")
SKILL_DESC="The Giver SKILL.md — tx chain, Dream Sharing, 6-section contract"

gh api --method PATCH "/gists/$SKILL_GIST_ID" \
    -f description="$SKILL_DESC" \
    --raw-field "files[SKILL.md][content]=$(cat "$SKILL_FILE")" \
    > /dev/null 2>&1 || {
        # Fallback: use jq for proper JSON escaping
        CONTENT=$(python3 -c "import json,sys; print(json.dumps(sys.stdin.read()))" < "$SKILL_FILE")
        payload=$(jq -n \
            --arg desc "$SKILL_DESC" \
            --arg content "$(cat "$SKILL_FILE")" \
            '{description: $desc, files: {"SKILL.md": {content: $content}}}')
        gh api --method PATCH "/gists/$SKILL_GIST_ID" \
            --input <(echo "$payload") \
            > /dev/null
    }
echo "  ✓ https://gist.github.com/sng2c/$SKILL_GIST_ID"

# Update README.md gist
echo -e "${GREEN}[2/2]${NC} Updating README.md gist ($README_GIST_ID)..."
README_DESC="The Giver 아키텍처"

payload=$(jq -n \
    --arg desc "$README_DESC" \
    --arg content "$(cat "$README_FILE")" \
    '{description: $desc, files: {"README.md": {content: $content}}}')
gh api --method PATCH "/gists/$README_GIST_ID" \
    --input <(echo "$payload") \
    > /dev/null
echo "  ✓ https://gist.github.com/sng2c/$README_GIST_ID"

echo ""
echo -e "${GREEN}Deploy complete.${NC}"
echo "  SKILL.md:      https://gist.github.com/sng2c/$SKILL_GIST_ID"
echo "  README:        https://gist.github.com/sng2c/$README_GIST_ID"