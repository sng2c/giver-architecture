#!/usr/bin/env python3
"""Dump raw per-chain JSON data from redbis-coding-test session artifacts.

One JSON file per chain, flat structure, no analysis.

Usage:
    python3 scripts/redbis-dump-data
    python3 scripts/redbis-dump-data --include-v24
"""

import json
import os
import sys
from pathlib import Path
from datetime import datetime

SESSIONS_DIR = Path.home() / ".pi" / "agent" / "sessions"
PROJECT = "redbis-coding-test"
OUTPUT_DIR = Path(__file__).parent.parent / "reports" / "redbis-data"

V22_CHAINS = ['b081a2d1', 'fde94195', '1e7b6908', '7cc68247']
V23_CHAINS = ['88b50634', 'dfb0ca9a', 'f882c75b']
V24_CHAINS = ['f272a284', 'f460e455', 'bf7539db']
# v2.5: each agent has its own run_id (chain = [planner, scout, worker] with different ids)
V25_CHAINS = {
    'v25-chain1': [('8ac2976c', 'planner', 0), ('c8f11a5d', 'scout', 0), ('fdfd5056', 'worker', 0)],
    'v25-chain2': [('d7d28fdc', 'planner', 0), ('00bc041b', 'scout', 0), ('fd6031d5', 'worker', 0)],
    'v25-chain3': [('be6df5e9', 'worker', 0)],
}
MONO_WORKER = '71521e3d'


def dump_chain(art_dir, run_id, approach, label):
    """Dump one chain's raw data to JSON."""
    agents_order = ['planner', 'scout', 'worker']
    start_idx = 0 if approach == 'monolithic' else None
    chain_data = {
        'approach': approach,
        'label': label,
        'run_id': run_id,
        'agents': []
    }

    if approach == 'monolithic':
        # Monolithic: only worker at index 0 (no planner/scout)
        agent_specs = [('worker', 0)]
    else:
        agent_specs = [(a, i) for i, a in enumerate(agents_order)]

    for agent, idx in agent_specs:
        meta_path = os.path.join(art_dir, f'{run_id}_{agent}_{idx}_meta.json')
        input_path = os.path.join(art_dir, f'{run_id}_{agent}_{idx}_input.md')
        output_path = os.path.join(art_dir, f'{run_id}_{agent}_{idx}_output.md')

        if not os.path.exists(meta_path):
            continue

        meta = json.load(open(meta_path))

        # Detect context type from input
        context_type = None
        if os.path.exists(input_path):
            content = open(input_path).read()
            if 'running from a fork' in content.lower():
                context_type = 'FORK'
            elif 'running from a fresh' in content.lower():
                context_type = 'FRESH'
            else:
                context_type = 'clean'

        agent_data = {
            'role': agent,
            'index': idx,
            'model': meta.get('model', ''),
            'input_tokens': meta['usage']['input'],
            'output_tokens': meta['usage']['output'],
            'cache_read': meta['usage'].get('cacheRead', 0),
            'cache_write': meta['usage'].get('cacheWrite', 0),
            'turns': meta['usage'].get('turns', 0),
            'tool_count': meta.get('toolCount', 0),
            'duration_ms': meta.get('durationMs', 0),
            'exit_code': meta.get('exitCode', 0),
            'success': meta.get('exitCode', 0) == 0,
            'context_type': context_type,
            'timestamp_epoch': meta.get('timestamp', 0),
        }

        chain_data['agents'].append(agent_data)

    chain_data['total_input'] = sum(a['input_tokens'] for a in chain_data['agents'])
    chain_data['total_output'] = sum(a['output_tokens'] for a in chain_data['agents'])
    chain_data['total_duration_ms'] = sum(a['duration_ms'] for a in chain_data['agents'])

    return chain_data


def dump_v25_chain(art_dir, label, agent_specs):
    """Dump v2.5 chain data where each agent has its own run_id."""
    chain_data = {
        'approach': 'giver-v2.5',
        'label': label,
        'run_id': agent_specs[0][0],  # first agent's run_id as chain ID
        'agents': []
    }

    for rid, agent, idx in agent_specs:
        meta_path = os.path.join(art_dir, f'{rid}_{agent}_{idx}_meta.json')
        input_path = os.path.join(art_dir, f'{rid}_{agent}_{idx}_input.md')

        if not os.path.exists(meta_path):
            print(f"  SKIP {rid}_{agent}_{idx} (no meta)")
            continue

        meta = json.load(open(meta_path))

        context_type = None
        if os.path.exists(input_path):
            content = open(input_path).read()
            if 'running from a fork' in content.lower():
                context_type = 'FORK'
            elif 'running from a fresh' in content.lower():
                context_type = 'FRESH'
            else:
                context_type = 'clean'

        agent_data = {
            'role': agent,
            'index': len(chain_data['agents']),
            'model': meta.get('model', ''),
            'input_tokens': meta['usage']['input'],
            'output_tokens': meta['usage']['output'],
            'cache_read': meta['usage'].get('cacheRead', 0),
            'cache_write': meta['usage'].get('cacheWrite', 0),
            'turns': meta['usage'].get('turns', 0),
            'tool_count': meta.get('toolCount', 0),
            'duration_ms': meta.get('durationMs', 0),
            'exit_code': meta.get('exitCode', 0),
            'success': meta.get('exitCode', 0) == 0,
            'context_type': context_type,
            'timestamp_epoch': meta.get('timestamp', 0),
        }

        chain_data['agents'].append(agent_data)

    chain_data['total_input'] = sum(a['input_tokens'] for a in chain_data['agents'])
    chain_data['total_output'] = sum(a['output_tokens'] for a in chain_data['agents'])
    chain_data['total_duration_ms'] = sum(a['duration_ms'] for a in chain_data['agents'])

    return chain_data


def main():
    include_v24 = '--include-v24' in sys.argv

    art_dir = os.path.join(SESSIONS_DIR, f'--root-{PROJECT}--', 'subagent-artifacts')
    if not os.path.exists(art_dir):
        print(f"Error: {art_dir} not found")
        sys.exit(1)

    OUTPUT_DIR.mkdir(parents=True, exist_ok=True)

    # Define chains to dump
    chains = []

    # Monolithic
    chains.append(('monolithic', 'monolithic', MONO_WORKER))

    # Giver v2.2
    for rid in V22_CHAINS:
        chains.append(('giver-v2.2', f'v22-{rid}', rid))

    # Giver v2.3
    for rid in V23_CHAINS:
        chains.append(('giver-v2.3', f'v23-{rid}', rid))

    # Giver v2.4
    if include_v24:
        for rid in V24_CHAINS:
            chains.append(('giver-v2.4', f'v24-{rid}', rid))

    # Giver v2.5 (each agent has own run_id)
    if include_v24:
        for label, specs in V25_CHAINS.items():
            chains.append(('giver-v2.5', label, specs))

    written = []
    for approach, label, run_id in chains:
        if approach == 'giver-v2.5':
            data = dump_v25_chain(art_dir, label, run_id)
        else:
            data = dump_chain(art_dir, run_id, approach, label)
        if not data['agents']:
            print(f"  SKIP {label} (no agents found)")
            continue

        filename = f'{label}.json'
        filepath = OUTPUT_DIR / filename
        with open(filepath, 'w') as f:
            json.dump(data, f, indent=2, ensure_ascii=False)

        agents_str = ' → '.join(
            f"{a['role']}({a['input_tokens']:,})" for a in data['agents']
        )
        print(f"  {filename:30s}  {data['total_input']:>10,}  {agents_str}")
        written.append(filename)

    print(f"\n  {len(written)} files → {OUTPUT_DIR}/")


if __name__ == '__main__':
    main()