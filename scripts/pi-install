#!/bin/bash
set -e

# The Giver — Install into ~/.pi
# Creates symlink for the giver skill

SRC_DIR="$(cd "$(dirname "$0")/.." && pwd)"

# Colors
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

echo -e "${YELLOW}=== The Giver Install ===${NC}"
echo ""

# === Symlink SKILL.md ===

SKILL_SRC="$SRC_DIR/.pi/agent/skills/giver/SKILL.md"
SKILL_TARGET="$HOME/.pi/agent/skills/giver/SKILL.md"

mkdir -p "$(dirname "$SKILL_TARGET")"

if [ -L "$SKILL_TARGET" ]; then
  existing=$(readlink "$SKILL_TARGET")
  if [ "$existing" = "$SKILL_SRC" ]; then
    echo -e "  ${YELLOW}skip${NC} SKILL.md (already linked)"
  else
    echo -e "  ${YELLOW}update${NC} SKILL.md (was: $existing)"
    rm "$SKILL_TARGET"
    ln -s "$SKILL_SRC" "$SKILL_TARGET"
    echo -e "  ${GREEN}link${NC} SKILL.md"
  fi
elif [ -f "$SKILL_TARGET" ]; then
  echo -e "  ${YELLOW}conflict${NC} SKILL.md (regular file exists, not symlink)"
  echo "         Remove $SKILL_TARGET manually and re-run."
else
  ln -s "$SKILL_SRC" "$SKILL_TARGET"
  echo -e "  ${GREEN}link${NC} SKILL.md"
fi

echo ""
echo -e "${GREEN}Install complete.${NC}"
echo ""
echo -e "  SKILL.md linked. Downstream agents (planner, scout, worker) run"
echo -e "  as fresh via the skill's \`context: \"fresh\"\` in chain invocations."
echo -e "  No global settings changes needed."