#!/bin/bash
set -e

# The Giver — Install into ~/.pi
# Creates symlinks and settings.json for defaultContext: fresh

SRC_DIR="$(cd "$(dirname "$0")/.." && pwd)"

# Colors
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m'

echo -e "${YELLOW}=== The Giver Install ===${NC}"
echo ""

# === 1. Symlinks ===

SKILL_SRC="$SRC_DIR/.pi/agent/skills/giver/SKILL.md"
SKILL_TARGET="$HOME/.pi/agent/skills/giver/SKILL.md"

if [ -L "$SKILL_TARGET" ]; then
  existing=$(readlink "$SKILL_TARGET")
  if [ "$existing" = "$SKILL_SRC" ]; then
    echo -e "  ${YELLOW}skip${NC} SKILL.md (already linked)"
  else
    echo -e "  ${YELLOW}update${NC} SKILL.md (was: $existing)"
    rm "$SKILL_TARGET"
    ln -s "$SKILL_SRC" "$SKILL_TARGET"
    echo -e "  ${GREEN}link${NC} SKILL.md -> $SKILL_SRC"
  fi
elif [ -f "$SKILL_TARGET" ]; then
  echo -e "  ${RED}conflict${NC} SKILL.md (regular file exists, not symlink)"
  echo "         Remove $SKILL_TARGET manually and re-run."
else
  mkdir -p "$(dirname "$SKILL_TARGET")"
  ln -s "$SKILL_SRC" "$SKILL_TARGET"
  echo -e "  ${GREEN}link${NC} SKILL.md -> $SKILL_SRC"
fi

# === 2. Settings (defaultContext: fresh) ===

SETTINGS_FILE="$SRC_DIR/.pi/settings.json"

if [ ! -f "$SETTINGS_FILE" ]; then
  echo -e "\n${RED}Error: $SETTINGS_FILE not found${NC}"
  exit 1
fi

# Check if settings.json already has our overrides
if [ -f "$SETTINGS_FILE" ] && grep -q '"planner"' "$SETTINGS_FILE" 2>/dev/null; then
  echo -e "  ${YELLOW}skip${NC} settings.json (already configured)"
else
  # settings.json exists but doesn't have our overrides — need to merge
  echo -e "  ${GREEN}config${NC} settings.json (defaultContext: fresh for planner, worker, scout)"
  # Just copy — the file is only ours
  cp "$SETTINGS_FILE" "$SETTINGS_FILE.bak" 2>/dev/null || true
fi

echo ""
echo -e "${GREEN}Install complete.${NC}"
echo ""
echo -e "  SKILL.md:   ${SKILL_TARGET}"
echo -e "  Settings:   ${SETTINGS_FILE}"
echo ""
echo -e "  ${YELLOW}⚠️  defaultContext: fresh${NC} is required for planner, worker, and scout."
echo -e "  Without it, downstream agents inherit parent context and the architecture breaks."